#!/usr/bin/env bash
# _tool_clip: rofi menu of transforms on the clipboard

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

clip_is_image() {
	if [[ -n $WAYLAND_DISPLAY ]]; then
		wl-paste --list-types | grep -q "image/png"
	else
		xclip -selection clipboard -t TARGETS -o | grep -q "image/png"
	fi
}

copy_image() {
	if [[ -n $WAYLAND_DISPLAY ]]; then
		wl-copy --type image/png <"$1"
	else
		xclip -selection clipboard -t image/png -i "$1"
	fi
}

# rofi reads -mesg as pango markup
escape_markup() {
	sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

show_menu() {
	local preview
	if clip_is_image; then
		csoi "$tmp/clip.png" >/dev/null
		preview=(-theme-str "window { background-image: url(\"$tmp/clip.png\"); }")
	else
		preview=(-mesg "Clipboard: $(cso | head -c 500 | tr '\n' ' ' | escape_markup)")
	fi
	printf '%s\n' "${actions[@]}" | rofi -dmenu -p 'Clipboard Action:' "${preview[@]}"
}

translate_menu() {
	from=$(printf "auto\nen\nes\nde\nja" | rofi -dmenu -p "Translate FROM:")
	[[ -z $from ]] && exit
	to=$(printf "en\nes\nde\nja" | rofi -dmenu -p "Translate TO:")
	[[ -z $to ]] && exit
	new_clip=$(cso | trans -brief -s "$from" -t "$to")
	printf "%s" "$new_clip" | cs
	notify-send "Translated ($from to $to)" "$new_clip"
	exit 0
}

actions=(
	"Uppercase"
	"Lowercase"
	"Trim whitespace"
	"Reverse text"
	"Remove newlines"
	"Base64 encode"
	"Base64 decode"
	"QR Encode"
	"QR Decode"
	"Image OCR to Text"
	"Translate (sub menu)"
	"Cancel"
)

choice=$(show_menu)
[[ $choice == "Cancel" || -z $choice ]] && exit

clip=$(cso)

case "$choice" in
"Uppercase") new_clip=$(printf "%s" "$clip" | tr '[:lower:]' '[:upper:]') ;;
"Lowercase") new_clip=$(printf "%s" "$clip" | tr '[:upper:]' '[:lower:]') ;;
"Trim whitespace") new_clip=$(printf "%s" "$clip" | sed 's/^[ \t]*//;s/[ \t]*$//') ;;
"Reverse text") new_clip=$(printf "%s" "$clip" | rev) ;;
"Remove newlines") new_clip=$(printf "%s" "$clip" | tr -d '\n') ;;
"Base64 encode") new_clip=$(printf "%s" "$clip" | base64) ;;
"Base64 decode") new_clip=$(printf "%s" "$clip" | base64 --decode 2>/dev/null) ;;
"QR Encode")
	printf "%s" "$clip" | qrencode -o "$tmp/qr.png"
	copy_image "$tmp/qr.png"
	notify-send "Clipboard Updated" "QR code copied as image"
	exit 0
	;;
"QR Decode")
	csoi "$tmp/clip.png" >/dev/null
	new_clip=$(zbarimg --quiet --raw "$tmp/clip.png" 2>/dev/null)
	;;
"Image OCR to Text")
	csoi "$tmp/clip.png" >/dev/null
	new_clip=$(tesseract "$tmp/clip.png" - -l eng 2>/dev/null)
	;;
"Translate (sub menu)") translate_menu ;;
*) exit 1 ;;
esac

printf "%s" "$new_clip" | cs
notify-send "Clipboard Updated" "$choice applied"
