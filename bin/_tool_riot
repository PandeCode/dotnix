#!/usr/bin/env bash
# _tool_riot: draw a rectangle and the focused window floats into it

set -euo pipefail

if [[ -n ${NIRI_SOCKET:-} ]]; then
	read -r x y w h < <(slurp -f "%x %y %w %h")
	# niri places floating windows relative to their output
	read -r ox oy < <(niri msg -j focused-output | jq -r '"\(.logical.x) \(.logical.y)"')
	if [[ $(niri msg -j focused-window | jq .is_floating) == false ]]; then
		niri msg action toggle-window-floating
	fi
	niri msg action set-window-width "$w"
	niri msg action set-window-height "$h"
	niri msg action move-floating-window -x "$((x - ox))" -y "$((y - oy))"

elif [[ -n ${SWAYSOCK:-} ]]; then
	read -r x y w h < <(slurp -f "%x %y %w %h")
	swaymsg floating enable
	swaymsg move position "$x" "$y"
	swaymsg resize set "$w" "$h"

elif [[ -n ${I3SOCK:-} ]] || pgrep -x i3 >/dev/null; then
	read -r x y w h < <(slop -b 3 -c 0.96,0.5,0.09 -t 0 -f "%x %y %w %h")
	i3-msg -q floating enable
	i3-msg -q move window position "$x" "$y"
	i3-msg -q resize set "$w" "$h"

else
	notify-send "riot" "not supported in this session"
	exit 1
fi
