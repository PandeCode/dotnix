#!/usr/bin/env bash
# cs: copies stdin. without a display (tmux, ssh) it goes through the
# terminal's clipboard, osc 52
if [[ -n $WAYLAND_DISPLAY ]]; then
	exec wl-copy
elif [[ -n $DISPLAY ]]; then
	exec xclip -selection clipboard
elif [[ -n $TMUX ]]; then
	exec tmux load-buffer -w -
else
	printf '\e]52;c;%s\a' "$(base64 -w0)" >/dev/tty
fi
