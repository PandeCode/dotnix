#!/usr/bin/env bash
# csoi [file]: prints the clipboard image as png, also into file when given
set -o pipefail
if [[ -n $WAYLAND_DISPLAY ]]; then
	wl-paste -t image/png
elif [[ -n $DISPLAY ]]; then
	xclip -selection clipboard -t image/png -o
else
	echo "csoi: no display" >&2
	exit 1
fi | tee "${1:-/dev/null}"
