-- stylua: ignore end

function transform(text, fontname)
	local font = fonts[fontname] or fonts.fraktur
	local result = ""
	for char in text:lower():gmatch(".") do
		result = result .. (font[char] or char)
	end
	return result
end

function showHelp()
	print("Unicode Font Transformer")
	print("Usage: norse [OPTION] [TEXT]")
	print()
	print("Options:")
	for name, _ in pairs(fonts) do
		print("  -" .. name:sub(1, 2) .. "    " .. name)
	end
	print()
	print("Examples:")
	print("  ./norse -fr 'hello'")
	print("  ./norse -bo 'world'")
	print("  echo 'test' | ./norse -mo")
end

local mode = "fraktur"
local text = nil

if arg[1] == "-h" or arg[1] == "--help" then
	showHelp()
	return
end

if arg[1] and arg[1]:match("^-") then
	local flag = arg[1]:sub(2)

	-- Try to find matching font
	for fontname, _ in pairs(fonts) do
		if fontname:sub(1, #flag) == flag then
			mode = fontname
			text = table.concat(arg, " ", 2)
			break
		end
	end

	-- If not found, check exact match
	if mode == "fraktur" then
		mode = arg[1]:sub(2) or "fraktur"
		text = table.concat(arg, " ", 2)
	end
else
	text = table.concat(arg, " ", 1)
end

-- Read from stdin if no text provided
if not text or text == "" then
	text = io.read()
end

print(transform(text, mode))
